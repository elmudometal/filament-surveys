{
    "name": "elmudo-dev/filament-surveys",
    "description": "Módulo de encuestas para Filament.",
    "keywords": [
        "Elmudo-Dev",
        "laravel",
        "filament",
        "surveys"
    ],
    "homepage": "https://github.com/elmudometal/filament-surveys",
    "support": {
        "issues": "https://github.com/elmudometal/filament-surveys/issues",
        "source": "https://github.com/elmudometal/filament-surveys"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "elmudometal",
            "email": "elmudometal@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.3 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "spatie/laravel-sluggable": "^3.7.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "ElmudoDev\\FilamentSurveys\\": "src/",
            "ElmudoDev\\FilamentSurveys\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElmudoDev\\FilamentSurveys\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElmudoDev\\FilamentSurveys\\FilamentSurveysServiceProvider"
            ],
            "aliases": {
                "FilamentSurveys": "ElmudoDev\\FilamentSurveys\\Facades\\FilamentSurveys"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
